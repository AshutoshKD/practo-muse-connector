# ================================================================
# PRACTO MUSE CONNECTOR — Environment Variables
# ================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it contains secrets!
# ================================================================

# ── Practo API Credentials ───────────────────────────────────────
# Get these from Practo after partner approval
# Email: api-support@practo.com to request access

PRACTO_API_KEY=your_practo_api_key_here
PRACTO_CLIENT_ID=your_practo_client_id_here
PRACTO_SITE_ID=your_practo_site_id_here

# Base URLs (confirm with Practo — these are standard)
PRACTO_API_BASE_URL=https://api.practo.com
PRACTO_SANDBOX_URL=https://sandbox.api.practo.com

# Set to 'sandbox' during development, 'production' when live
PRACTO_ENV=sandbox

# ── Your Connector's Own Secret Key ──────────────────────────────
# Muse will send this in the header to authenticate calls to YOUR server
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_SECRET_KEY=generate_a_random_32_char_string_here

# ── Server Config ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Stripe Payment Keys ───────────────────────────────────────────
# Get these from: https://dashboard.stripe.com/apikeys
# Use TEST keys during development, LIVE keys in production

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_CURRENCY=inr

# ── Optional: Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
